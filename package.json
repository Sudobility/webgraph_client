{
  "name": "@sudobility/webgraph_client",
  "version": "0.0.11",
  "type": "module",
  "description": "Client SDK for webgraph_api",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/webgraph_client.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "build:watch": "bunx tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "test:unit": "bunx vitest run --passWithNoTests",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src/",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "sh -c 'test ! -f ../workflows/scripts/check-publish-safety.cjs || node ../workflows/scripts/check-publish-safety.cjs' && rm -rf dist && bun run build"
  },
  "license": "BUSL-1.1",
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@types/node": "~24.19.2",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "globals": "~16.5.0",
    "prettier": "~3.9.10",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
